{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@auth/*": ["./src/auth/*"],
      "@catalog/*": ["./src/catalog/*"],
      "@cart/*": ["./src/cart/*"],
      "@order/*": ["./src/order/*"],
      "@payment/*": ["./src/payment/*"],
      "@notification/*": ["./src/notification/*"],
      "@discount/*": ["./src/discount/*"]
    }
  }
}
