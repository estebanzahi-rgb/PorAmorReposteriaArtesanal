# ─── Base de datos (Neon en producción) ──────────────────────────────────────
# Local: postgresql://poramor_user:poramor_pass@localhost:5432/poramor_db
# Neon:  postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://poramor_user:poramor_pass@localhost:5432/poramor_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
# Local:       http://localhost:3001/api/auth/google/callback
# Producción:  https://tu-backend.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── CORS ────────────────────────────────────────────────────────────────────
# Local:       http://localhost:3000
# Producción:  https://tu-proyecto.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAILS=duena@poramor.com

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_tu_api_key_de_resend
RESEND_FROM_EMAIL=noreply@poramor.com

# ─── Negocio ─────────────────────────────────────────────────────────────────
OWNER_EMAIL=duena@poramor.com
OWNER_WHATSAPP=+573001234567

# ─── MercadoPago ─────────────────────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.co/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu_access_token
# Opcional: secreto para validar firma HMAC del webhook (configurar en MP panel)
MERCADOPAGO_WEBHOOK_SECRET=
# URLs de redirección post-pago (deben ser públicas en producción)
MERCADOPAGO_SUCCESS_URL=http://localhost:3000/pedidos?pago=exitoso
MERCADOPAGO_FAILURE_URL=http://localhost:3000/pedidos?pago=fallido
MERCADOPAGO_PENDING_URL=http://localhost:3000/pedidos?pago=pendiente
# URL que MP llamará con el webhook (debe ser pública — usar ngrok en local)
MERCADOPAGO_WEBHOOK_URL=https://tu-ngrok-o-backend-publico.com/api/payments/mercadopago/webhook

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
