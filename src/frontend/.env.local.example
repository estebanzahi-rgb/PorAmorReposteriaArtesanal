# ─── NextAuth ────────────────────────────────────────────────────────────────
# Local:       http://localhost:3000
# Producción:  https://tu-proyecto.vercel.app  (en Vercel se llama NEXTAUTH_URL)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ─── Backend API ─────────────────────────────────────────────────────────────
# Local:       http://localhost:3001/api
# Producción:  https://tu-backend.onrender.com/api
API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── WhatsApp del negocio (sin +, ej: 573007600426) ──────────────────────────
NEXT_PUBLIC_OWNER_WHATSAPP=573001234567

# ─── URL pública del sitio (SEO: sitemap, OG tags) ───────────────────────────
# Local:       http://localhost:3000
# Producción:  https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cloudinary (subida de imágenes desde el panel admin) ────────────────────
# Crear cuenta en https://cloudinary.com y obtener las credenciales del dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
