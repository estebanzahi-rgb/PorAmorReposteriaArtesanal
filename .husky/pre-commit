#!/usr/bin/env sh

echo "[pre-commit] TypeScript check -- frontend..."
cd src/frontend && npm run typecheck
FRONTEND_EXIT=$?
cd ../..

echo "[pre-commit] TypeScript check -- backend..."
cd src/backend && npm run typecheck
BACKEND_EXIT=$?
cd ../..

if [ $FRONTEND_EXIT -ne 0 ] || [ $BACKEND_EXIT -ne 0 ]; then
  echo "FAILED: TypeScript errors found. Fix them before committing."
  exit 1
fi

echo "[pre-commit] Checking if dev servers are running..."
SERVERS_UP=$(node -e "
const http = require('http');
const check = (port, cb) => {
  const req = http.get('http://localhost:' + port, () => cb(true));
  req.on('error', () => cb(false));
  req.setTimeout(2000, () => { req.destroy(); cb(false); });
};
check(3000, (fe) => check(3001, (be) => {
  process.stdout.write(fe && be ? 'yes' : 'no');
  process.exit(0);
}));
" 2>/dev/null)

if [ "$SERVERS_UP" = "yes" ]; then
  echo "[pre-commit] Servers up -- running E2E tests..."
  cd src/frontend && npm run test:e2e
  E2E_EXIT=$?
  cd ../..
  if [ $E2E_EXIT -ne 0 ]; then
    echo "FAILED: E2E tests failed. Fix them before committing."
    exit 1
  fi
  echo "OK: E2E tests passed."
else
  echo "WARNING: Servers not running -- skipping E2E. Run 'npm run test:e2e --prefix src/frontend' manually before pushing."
fi

echo "OK: pre-commit checks passed."
